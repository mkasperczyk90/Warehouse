{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  // Dev bootstrap admin credentials (see IdentityBridgeOptions) — this ephemeral environment has no
  // dedicated Keycloak service-account client; harden before any non-ephemeral use.
  "IdentityBridge": {
    "BucketName": "",
    "Region": "eu-central-1",
    "KeycloakBaseUrl": "http://localhost:8080",
    "Realm": "warehouse",
    "AdminUsername": "admin",
    "AdminPassword": "admin",
    "PollIntervalSeconds": 300
  }
}
